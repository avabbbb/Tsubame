{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsubame.local/schemas/provider-manifest.schema.json",
  "title": "Tsubame Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "kind", "execution", "capabilities"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Adapter/protocol implementation, e.g. openai-compatible, faster-whisper, apple-speech."
    },
    "execution": {
      "enum": ["remote_api", "local_server", "local_runtime", "native_os"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supports_model_discovery": { "type": "boolean", "default": false },
    "requires_secret": { "type": "boolean", "default": false },
    "runtime_pack": { "type": ["string", "null"] }
  }
}
